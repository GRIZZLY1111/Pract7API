<Page x:Class="Pract7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Background="{DynamicResource Fon}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="Add" Click="Add_Click" Style="{DynamicResource StandardButton}" Content="Добавить" Grid.Column="0"/>
            <Button Name="Correct" Click="Correct_Click" Style="{DynamicResource StandardButton}" Content="Изменить" Grid.Column="1"/>
            <Button Name="Delete" Click="Delete_Click" Style="{DynamicResource DeleteButton}" Content="Удалить" Grid.Column="2"/>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource BorderWithMargin}" Background="{DynamicResource Panel}">
            <StackPanel Style="{DynamicResource StackPanelOrientationH}">
                <TextBlock Text="Поиск: " VerticalAlignment="Center" Style="{DynamicResource TextBlockWithMargin}" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchTextBox" Width="200" Style="{DynamicResource TextBoxWithMargin}" TextChanged="FilterChanged"/>
                <TextBlock Text="Тип блюда: " VerticalAlignment="Center" Style="{DynamicResource TextBlockWithMargin}" Margin="0,0,5,0"/>
                <ComboBox x:Name="VegetarianFilterComboBox" Width="180" SelectedIndex="0" SelectionChanged="FilterChanged" Style="{DynamicResource MaterialDesignComboBox}">
                    <ComboBoxItem Content="Все блюда"/>
                    <ComboBoxItem Content="Только вегетарианские"/>
                    <ComboBoxItem Content="Только не вегетарианские"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <ListView ItemsSource="{Binding recipe}" SelectedItem="{Binding recept}" Style="{DynamicResource ListViewBackground}" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Style="{DynamicResource StackPanelOrientationH}" Margin="5">
                        <StackPanel Width="120">
                            <TextBlock Text="id: " Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="name: " Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="cuisine: " Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="cookingTime: " Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="calories: " Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="isVegetarian: " Style="{DynamicResource TextBlockWithMargin}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="{Binding Cuisine}" Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="{Binding CookingTime}" Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="{Binding Calories}" Style="{DynamicResource TextBlockWithMargin}"/>
                            <TextBlock Text="{Binding IsVegetarian}" Style="{DynamicResource TextBlockWithMargin}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>